Subject: [PATCH 02/10] Add Library shapes visibility setting for shape browser

---
 .../src/components/shape-browser-panel.ts     | 22 +++++++++-
 .../src/services/editor-setting-service.ts    |  3 ++
 .../general-setting/editor/edgeless/shape.tsx | 41 +++++++++++++++++++
 3 files changed, 65 insertions(+), 1 deletion(-)

diff --git a/blocksuite/affine/gfx/shape/src/components/shape-browser-panel.ts b/blocksuite/affine/gfx/shape/src/components/shape-browser-panel.ts
index 6f11bd42c6dcca87399636bf49fc4f21bcf417b8..bc87bfb43cb08787b482f5020ed7f636968a30d7 100644
--- a/blocksuite/affine/gfx/shape/src/components/shape-browser-panel.ts
+++ b/blocksuite/affine/gfx/shape/src/components/shape-browser-panel.ts
@@ -7,7 +7,10 @@ import {
   type ShapeStyle,
   ShapeType,
 } from '@blocksuite/affine-model';
-import { ThemeProvider } from '@blocksuite/affine-shared/services';
+import {
+  EditorSettingProvider,
+  ThemeProvider,
+} from '@blocksuite/affine-shared/services';
 import {
   requestConnectedFrame,
   stopPropagation,
@@ -575,6 +578,23 @@ export class EdgelessShapeBrowserPanel extends WithDisposable(LitElement) {
     setTimeout(focusNow, 0);
   }
 
+  private _getFilteredItems(includeSearchableLibraries = true) {
+    const visibility = this.edgeless?.std
+      ?.getOptional(EditorSettingProvider)
+      ?.setting$.peek().edgelessLibraryShapesVisibility;
+    const mode = visibility ?? 'show';
+    const hasSearch =
+      includeSearchableLibraries && this._searchKeyword.trim().length > 0;
+
+    if (mode === 'show') return SHAPE_BROWSER_ITEMS;
+
+    return SHAPE_BROWSER_ITEMS.filter(shape => {
+      const isLibraryShape = shape.name === ShapeType.DrawioStencil;
+      if (!isLibraryShape) return true;
+      if (mode === 'disable') return false;
+      return hasSearch;
+    });
+  }
   private _getShapesForCategory(category: ShapeCategory) {
     let shapes = SHAPE_BROWSER_ITEMS.filter(
       shape => shape.category === category
diff --git a/blocksuite/affine/shared/src/services/editor-setting-service.ts b/blocksuite/affine/shared/src/services/editor-setting-service.ts
index abd9b3d44f1dffa267b139bd6caa1fa7fddbcfaf..5457f5a402a18bde97d8453756cb6558a602bea1 100644
--- a/blocksuite/affine/shared/src/services/editor-setting-service.ts
+++ b/blocksuite/affine/shared/src/services/editor-setting-service.ts
@@ -10,6 +10,9 @@ export const GeneralSettingSchema = z
   .object({
     edgelessScrollZoom: z.boolean().default(false),
     edgelessDisableScheduleUpdate: z.boolean().default(false),
+    edgelessLibraryShapesVisibility: z
+      .enum(['disable', 'searchable', 'show'])
+      .default('show'),
     docCanvasPreferView: z
       .enum(['affine:embed-linked-doc', 'affine:embed-synced-doc'])
       .default('affine:embed-synced-doc'),
diff --git a/packages/frontend/core/src/desktop/dialogs/setting/general-setting/editor/edgeless/shape.tsx b/packages/frontend/core/src/desktop/dialogs/setting/general-setting/editor/edgeless/shape.tsx
index 84d6bcc3d71d88bfd28d660fb91be795e7c4d7eb..33d19b8869f53e07c8aee126416614add0aab43c 100644
--- a/packages/frontend/core/src/desktop/dialogs/setting/general-setting/editor/edgeless/shape.tsx
+++ b/packages/frontend/core/src/desktop/dialogs/setting/general-setting/editor/edgeless/shape.tsx
@@ -52,6 +52,8 @@ enum ShapeTextFontSize {
   '64px' = '64',
 }
 
+type LibraryShapesVisibility = 'disable' | 'searchable' | 'show';
+
 export const ShapeSettings = () => {
   const t = useI18n();
   const framework = useFramework();
@@ -179,6 +181,36 @@ export const ShapeSettings = () => {
     [editorSetting, currentShape]
   );
 
+  const libraryShapesItems = useMemo<RadioItem[]>(
+    () => [
+      {
+        value: 'disable',
+        label: 'Disable',
+      },
+      {
+        value: 'searchable',
+        label: 'Searchable',
+      },
+      {
+        value: 'show',
+        label: 'Show',
+      },
+    ],
+    []
+  );
+
+  const libraryShapesVisibility =
+    settings.edgelessLibraryShapesVisibility ?? 'show';
+  const setLibraryShapesVisibility = useCallback(
+    (value: string) => {
+      editorSetting.set(
+        'edgelessLibraryShapesVisibility',
+        value as LibraryShapesVisibility
+      );
+    },
+    [editorSetting]
+  );
+
   const shapes = useMemo<RadioItem[]>(
     () => [
       {
@@ -613,6 +645,15 @@ export const ShapeSettings = () => {
           onChange={setTextAlignment}
         />
       </SettingRow>
+      <SettingRow name={'Library shapes'} desc={''}>
+        <RadioGroup
+          items={libraryShapesItems}
+          value={libraryShapesVisibility}
+          width={250}
+          className={settingWrapper}
+          onChange={setLibraryShapesVisibility}
+        />
+      </SettingRow>
     </>
   );
 };
