-import { drawioLibraryStencilShapes } from './library-stencils.js';
 import { drawioStencilShapes } from './stencils.js';
 
 export type StencilCommand =
@@ -41,11 +40,29 @@ export type StencilShapeData = {
 
 const allStencilShapes = {
   ...drawioStencilShapes,
-  ...drawioLibraryStencilShapes,
 } as unknown as Record<string, StencilShapeData>;
 
+let libraryShapesLoaded = false;
+let libraryShapesLoading: Promise<void> | null = null;
+
 export const STENCIL_SHAPE_NAMES = Object.keys(allStencilShapes).sort();
 
+export async function ensureLibraryStencilShapesLoaded(): Promise<void> {
+  if (libraryShapesLoaded) return;
+  if (libraryShapesLoading) return libraryShapesLoading;
+
+  libraryShapesLoading = import('./library-stencils.js')
+    .then(mod => {
+      Object.assign(allStencilShapes, mod.drawioLibraryStencilShapes);
+      libraryShapesLoaded = true;
+    })
+    .finally(() => {
+      libraryShapesLoading = null;
+    });
+
+  return libraryShapesLoading;
+}
+
 export const getStencilShapeData = (name: string): StencilShapeData | null =>
   allStencilShapes[name] ?? null;
 
